# Which live LLM backend to use: openai | anthropic | mock
# If the selected provider has no matching API key set below, Jarvis falls back
# to the deterministic MockProvider automatically (see app/agents/providers.py).
MODEL_PROVIDER=openai

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Only needed if Anthropic rejects requests with HTTP 400 "This API
# key is not scoped to a workspace..." — set it to that workspace's id.
# Leave blank for a workspace-scoped key (the common case); nothing changes.
ANTHROPIC_WORKSPACE_ID=

DATABASE_URL=sqlite+aiosqlite:///./jarvis.db
JARVIS_ENV=development
LOG_LEVEL=INFO

# Per-agent model names. These must match the selected MODEL_PROVIDER's model IDs:
#   openai:    e.g. gpt-4o, gpt-4o-mini
#   anthropic: e.g. claude-opus-5, claude-sonnet-5, claude-haiku-4-5
JARVIS_MODEL=gpt-4o
RESEARCH_MODEL=gpt-4o-mini
STRATEGY_MODEL=gpt-4o
QA_MODEL=gpt-4o-mini
EXECUTION_MODEL=gpt-4o-mini

MAX_AGENT_RETRIES=2
MAX_CONCURRENT_AGENTS=3
MAX_TASKS_PER_RUN=25
MAX_TOOL_CALLS_PER_TASK=10

LOG_SENSITIVE_DATA=false

# --- Research capability (v0.1.1 / v0.1.2) ----------------------------------
# dev    = exact v0.1 behavior: no provider call, Research Agent reports
#          insufficient_evidence=true and clearly-labeled sample findings.
# mock   = deterministic MockResearchProvider (no network) — exercises the
#          full evidence pipeline (EvidenceItem -> Strategy -> QA) for tests/demos.
# tavily = live search via the Tavily API (https://tavily.com). Requires
#          TAVILY_API_KEY below. See docs/evidence.md and
#          scripts/test_tavily_connection.py (run manually, makes one real call).
# live   = reserved for any *other* vendor. No such vendor is wired up yet;
#          setting this raises a clear error until one is chosen and implemented.
RESEARCH_PROVIDER=dev
RESEARCH_MAX_RESULTS=5
RESEARCH_FETCH_TIMEOUT_SECONDS=10.0
RESEARCH_MAX_RESPONSE_BYTES=2000000
RESEARCH_MAX_REDIRECTS=3
EVIDENCE_STALE_AFTER_DAYS=540

# Only read when RESEARCH_PROVIDER=tavily. Get a key at https://tavily.com.
TAVILY_API_KEY=
# "basic" (default, low-cost) or "advanced" (deeper, more expensive).
TAVILY_SEARCH_DEPTH=basic

# --- Selective evidence extraction (v0.1.1 checkpoint 3) --------------------
# Bounded, provider-neutral upgrade of search-snippet evidence to deeper
# page-extract evidence via ResearchProvider.fetch(), only during targeted
# evidence-gap follow-up research (never the initial broad discovery search).
# See docs/evidence.md. Conservative by design — do not set an unbounded value.
RESEARCH_ENABLE_FETCH=true
RESEARCH_MAX_FETCH_PER_TASK=2
RESEARCH_FETCH_MAX_CHARS=12000

# --- Research output bounds (v0.1.1 reliability checkpoint) -----------------
# ResearchOutput must stay bounded across retries, deterministically — not
# just via prompt wording. The persisted Evidence table keeps everything
# regardless of these limits; only the structured output/prompt is capped.
RESEARCH_MAX_FINDINGS=12
RESEARCH_MAX_EVIDENCE_ITEMS=15
RESEARCH_MAX_OPEN_QUESTIONS=8
RESEARCH_MAX_ASSUMPTIONS=8
RESEARCH_MAX_GAPS=8
RESEARCH_MAX_FINDING_CHARS=1000
RESEARCH_MAX_EVIDENCE_EXCERPT_CHARS=600

# --- Budget guardrails (v0.1.1) ---------------------------------------------
# A "mission" is one project/objective run (app.orchestration.executor.run_objective).
# Reaching either limit stops the run cleanly before starting a new task batch;
# already-completed work and a partial executive report are preserved.
MAX_API_CALLS_PER_MISSION=40
MAX_TOKENS_PER_MISSION=200000
# Both cost limits require MODEL_PRICING_JSON to be configured below — with no
# pricing configured, estimated cost is always "unset", never zero, so these
# limits are effectively disabled until pricing is provided. Leave commented
# out to disable (an empty value is not valid — pydantic-settings rejects "").
# MAX_ESTIMATED_COST_PER_MISSION_USD=10.0
# DAILY_COST_LIMIT_USD=25.0

# JSON map of model id -> {"input_per_million_usd": x, "output_per_million_usd": y}.
# Left empty by default: no price is ever guessed. Example:
# MODEL_PRICING_JSON={"claude-sonnet-5": {"input_per_million_usd": 3.0, "output_per_million_usd": 15.0}}
MODEL_PRICING_JSON={}
