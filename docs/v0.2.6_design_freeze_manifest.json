      "folded_into_frozen_text": false,
      "implementation_constraint": "CR-TASK-01 Scheduler and CR-ESC-01 ESC Issuer must implement |chain_predecessor_esc_ids| = 1 for every RETRY/CONTINUATION and refuse any relation with a larger chain set (ESC_RELATION_UNTRUSTED), unless HR12-01 option (b) multi-chain merge semantics are separately designed, hostile-reviewed and Human-Owner-approved."
    },
    {
      "id": "HR12-02",
      "severity": "LOW",
      "title": "Fork checkpoint lateness tolerance undefined",
      "owner_disposition": "ACCEPTED_NON_FREEZE_BLOCKING",
      "freeze_blocker": false,
      "implementation_blocker": true,
      "deployment_blocker": false,
      "folded_into_frozen_text": false,
      "implementation_constraint": "CR-TASK-01 Scheduler and CR-ESC-01 ESC Issuer must: fix a TCB tolerance delta; evaluate the fork predicate over the source's state as of the checkpoint instant; require ForkAuthorization.created_at <= instant + delta, else record SKIPPED; require the FORK ESC transaction within delta-prime of the authorization, else it expires unused; have the ESC Issuer verify both; evaluate each checkpoint independently of earlier SKIPPED ones."
    }
